#!/bin/sh
# Merge the claude-mem worker settings these dotfiles own into
# ~/.claude-mem/settings.json and keep the rest, because the worker writes the
# same file and it holds provider keys that stay out of this repository.
set -eu
current="$(cat)"
[ -n "$current" ] || current='{}'

# The worker runs here as the systemd user unit claude-mem.service, on loopback
# port 37701, so nothing here may start one of its own. The other machines
# reach it through the tailnet forward run_onchange_after_claude-mem-tailnet.sh.tmpl
# sets up. Its observer is Claude
# Code on gpt-6-luna, reached through the proxenos daemon on this machine.
#
# Tier routing sends a batch whose observations all come from Read, Glob, Grep,
# LS or ListMcpResourcesTool to CLAUDE_MEM_TIER_SIMPLE_MODEL. Its default, the
# alias "haiku", reaches the provider daemon as claude-haiku-5-5, which the
# Codex account refuses with a 400. The daemon's tier map (haiku = gpt-6-luna)
# does not apply here. Claude Code reads it only from the
# ANTHROPIC_DEFAULT_*_MODEL environment a proxenos launch sets, and the
# worker's environment comes from its systemd unit. The daemon itself maps only
# a bare tier name or the upstream id, so the models below name gpt-6-luna.
#
# My Work's automatic refresh, from claude-mem 15.1, runs Claude Code on the
# haiku and sonnet aliases, which nothing here can rename. So the unit has a
# hand-written drop-in, ~/.config/systemd/user/claude-mem.service.d/
# model-aliases.conf, naming a model the daemon serves for each: gpt-6-luna for
# haiku (grouping, focus) and gpt-6.1-terra for sonnet (goals, review, story),
# since on gpt-6-luna two long requests overran the review's length limits on
# every run. With the refresh on and no drop-in, every refresh is refused and
# tried again ten minutes later, and My Work reads "Sorting…" on every request.
#
# From 15.4 the observer answers one queued event per prompt unless
# CLAUDE_MEM_CLAUDE_OBSERVATION_BATCH_SIZE asks for more (1 to 32). One per
# prompt is the pacing under which an active session here queued 200
# observations in ten minutes while 56 were answered (13.28.1), so it takes 8.
# The 13.39 fork batches its backlog by itself and does not read the key.
printf '%s' "$current" | jq '. + {
  "CLAUDE_MEM_MODEL": "gpt-6-luna",
  "CLAUDE_MEM_PROVIDER": "claude",
  "CLAUDE_MEM_WORKER_HOST": "127.0.0.1",
  "CLAUDE_MEM_WORKER_PORT": "37701",
  "CLAUDE_MEM_WORKER_AUTOSTART": "false",
  "CLAUDE_MEM_TIER_SIMPLE_MODEL": "gpt-6-luna",
  "CLAUDE_MEM_WORK_VIEW_AUTO_REFRESH": "true",
  "CLAUDE_MEM_CLAUDE_OBSERVATION_BATCH_SIZE": "8"
}'
