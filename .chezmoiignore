# Per-machine exclusions. Entries are target paths relative to $HOME.

{{- if eq .machine "cloud" }}
# The cloud harness keeps its GitHub proxy settings in root's global gitconfig.
.gitconfig
# Agents in cloud sessions run bash with the environment's own variables.
.zshenv
.zshrc
{{- end }}

{{- if ne .machine "laptop" }}
# Global tool fallbacks. Projects pin their own versions in .tool-versions.
.config/mise/config.toml
# Laptop-only startup files. Linux machines keep their distro defaults.
.zprofile
.bashrc
.profile
{{- end }}

{{- if ne .machine "exe" }}
# herdr on the exe.dev VMs only. The laptop keeps its own herdr config.
.config/herdr/config.toml
{{- end }}

{{- if eq .chezmoi.hostname "agamemnon" }}
# Genduk's sandbox cannot read ~/, so this VM keeps its own copies of the two
# media skills, with their scripts in /usr/local/lib/genduk-skills/. The ops
# repository's README says how they are copied.
.claude/skills/analyzing-video
.claude/skills/analyzing-video/**
.claude/skills/transcribe-audio
.claude/skills/transcribe-audio/**
{{- end }}

# Bootstrap scripts run before chezmoi exists; they are not dotfiles.
bootstrap
bootstrap/**
